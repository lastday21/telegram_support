# Секреты серверной части. Они используются только внутри Docker.
YC_API_KEY=
YC_FOLDER_ID=
TG_BOT_TOKEN=
TG_CHAT_ID=

# Общий ключ между сервером и программой Windows.
APP_ACCESS_TOKEN=

# Адрес сервера для запуска программы Windows из исходников.
SERVER_URL=http://127.0.0.1:8000

# Необязательные имена устройств записи Windows.
MIC_DEVICE=
MIX_DEVICE=
