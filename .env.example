# Секреты серверной части. Они используются только внутри Docker.
YC_API_KEY=
YC_FOLDER_ID=
YC_MODEL=qwen3-235b-a22b-fp8/latest
YC_VISION_MODEL=qwen3.6-35b-a3b
TG_BOT_TOKEN=
TG_CHAT_ID=
VK_GROUP_TOKEN=
VK_GROUP_ID=
VK_USER_ID=
VK_API_VERSION=5.199

# Ограничение нагрузки на Яндекс для программы Windows и Telegram-бота.
YANDEX_MAX_CONCURRENT=2
YANDEX_QUEUE_SIZE=8
YANDEX_QUEUE_TIMEOUT=300
YANDEX_RETRY_DELAYS=0.5,1.5
YANDEX_FAILURE_LIMIT=5
YANDEX_RECOVERY_SECONDS=30

# Ограничение входящих запросов к серверу.
HTTP_MAX_CONCURRENT=16
HTTP_REQUEST_LIMIT=120
HTTP_RATE_WINDOW=60
HTTP_MAX_BODY_SIZE=23068672
AUTH_FAILURE_LIMIT=5
AUTH_FAILURE_WINDOW=60
AUTH_BLOCK_SECONDS=300

# Проверки внешних служб сохраняются на 30 секунд.
HEALTH_CACHE_SECONDS=30
HEALTH_TIMEOUT=5

# Общий ключ между сервером и программой Windows.
APP_ACCESS_TOKEN=

# Адрес сервера для запуска программы Windows из исходников.
SERVER_URL=http://127.0.0.1:8000

# Необязательные имена устройств записи Windows.
MIC_DEVICE=
MIX_DEVICE=
